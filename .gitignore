__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# rpi-image-gen build output
work/
deploy/
*.img
*.img.xz
*.sha256

# local scratch

# vendored driver source, fetched by scripts/fetch-vendor.sh
image/files/vendor/

# local dev config for the emulator
scoreboard.local.toml

# team logos, fetched by scripts/fetch-logos.py into size-numbered dirs
# (32/, 64/, ...). assets/logos/overrides/ is NOT matched by this -- those
# are hand-picked overrides for teams whose official crest doesn't
# downscale well (#12), curated rather than fetched, committed like the
# horns are. A blanket `assets/logos/` ignore would also hide overrides/,
# since git won't descend into an ignored directory even for a negated
# path underneath -- ignoring only the fetched pattern avoids that.
assets/logos/[0-9]*/

# team-specific goal horns are a user drop-in slot -- real recordings,
# likely copyrighted, same reasoning as logos not being redistributed.
# Never committed, unlike _default.wav (synthesized, no such issue).
assets/horns/*.wav
!assets/horns/_default.wav
