[Unit]
Description=Apply scoreboard settings from the boot partition
Documentation=https://github.com/diggforbeer/scoreboard
# Runs on every boot, not just the first, so editing scoreboard.toml on the
# boot partition is all it takes to change Wi-Fi network or timezone.
After=local-fs.target
Before=nhl-scoreboard.service
Wants=nhl-scoreboard.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Wi-Fi rollback (#51) writes the last known-good [wifi] values back into
# scoreboard.toml through nhl_scoreboard.config.Settings.save() -- the same
# tomlkit write-back the eventual config editor uses -- rather than a second
# TOML writer, so this needs the app package on the import path too.
Environment=PYTHONPATH=/opt/nhl-scoreboard
ExecStart=/usr/local/sbin/scoreboard-provision /boot/firmware/scoreboard.toml

[Install]
WantedBy=multi-user.target
