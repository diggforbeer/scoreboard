[Unit]
Description=NHL scoreboard on HUB75 LED matrix
Documentation=https://github.com/diggforbeer/scoreboard
After=network-online.target scoreboard-provision.service
Wants=network-online.target
After=systemd-time-wait-sync.service

[Service]
Type=simple
# The rgbmatrix driver needs direct GPIO and hard realtime scheduling,
# so it runs as root and keeps its privileges (drop_privileges=False).
User=root
Environment=PYTHONPATH=/opt/nhl-scoreboard
Environment=PYTHONUNBUFFERED=1
Environment=NHL_SCOREBOARD_FONT_DIR=/usr/share/nhl-scoreboard/fonts
ExecStart=/usr/bin/python3 -m nhl_scoreboard --config /boot/firmware/scoreboard.toml
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
