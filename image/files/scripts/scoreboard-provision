#!/usr/bin/python3
"""Apply settings from the boot-partition config file.

Runs on every boot via scoreboard-provision.service. Its job is to turn the
human-editable ``scoreboard.toml`` on the FAT boot partition into the system
state the appliance needs -- Wi-Fi credentials for iwd, the timezone, and the
wireless regulatory domain.

Failures here are logged but never fatal: a typo in the config file must not
stop the board from booting, and an unreachable Wi-Fi network should still
leave a working console.

Wi-Fi joining/rollback itself lives in ``nhl_scoreboard.wifi`` (#133) --
factored out so the AP setup page's live join flow can call the exact same
tested path as this boot-time one, instead of a second reimplementation.
This script's only job for wifi is reading ``[wifi]`` out of the TOML and
handing it off.
"""

from __future__ import annotations

import logging
import os
import sys
import tomllib
from pathlib import Path

#: Same overridable convention as nhl_scoreboard.wifi's IWD_DIR, so tests can
#: exercise apply_timezone() against real files without touching the actual
#: system's /usr/share/zoneinfo, /etc/localtime or /etc/timezone.
ZONEINFO = Path(os.environ.get("NHL_SCOREBOARD_ZONEINFO_DIR", "/usr/share/zoneinfo"))
LOCALTIME = Path(os.environ.get("NHL_SCOREBOARD_LOCALTIME", "/etc/localtime"))
TIMEZONE_FILE = Path(os.environ.get("NHL_SCOREBOARD_TIMEZONE_FILE", "/etc/timezone"))

log = logging.getLogger("scoreboard-provision")


def main(argv: list[str]) -> int:
    logging.basicConfig(format="%(levelname)s: %(message)s", level=logging.INFO)
    path = Path(argv[1]) if len(argv) > 1 else Path("/boot/firmware/scoreboard.toml")

    config = read_config(path)
    if config is None:
        return 0

    apply_timezone(config.get("scoreboard", {}))
    # Imported here, not at module load: this script has to keep running
    # (timezone/regdom) even on a board where the nhl_scoreboard package
    # somehow isn't importable, same tolerance read_config() already has
    # for a malformed scoreboard.toml.
    try:
        from nhl_scoreboard.wifi import apply_wifi
    except ImportError:
        log.error("nhl_scoreboard package not importable; skipping Wi-Fi setup")
        return 0
    wifi = config.get("wifi", {})
    timeout = wifi.get("connect_timeout_seconds")
    apply_wifi(wifi, path, connect_timeout=float(timeout) if timeout is not None else None)
    return 0


def read_config(path: Path) -> dict | None:
    if not path.is_file():
        log.warning("No config at %s; leaving system settings untouched", path)
        return None
    try:
        with path.open("rb") as fh:
            return tomllib.load(fh)
    except (OSError, tomllib.TOMLDecodeError) as exc:
        log.error("Could not parse %s: %s", path, exc)
        return None


def apply_timezone(scoreboard: dict) -> None:
    tz = str(scoreboard.get("timezone") or "").strip()
    if not tz:
        return
    if not (ZONEINFO / tz).exists():
        log.error("Unknown timezone %r; keeping current setting", tz)
        return
    try:
        if LOCALTIME.is_symlink() and LOCALTIME.readlink() == ZONEINFO / tz:
            return
        LOCALTIME.unlink(missing_ok=True)
        LOCALTIME.symlink_to(ZONEINFO / tz)
        TIMEZONE_FILE.write_text(f"{tz}\n")
        log.info("Timezone set to %s", tz)
    except OSError as exc:
        log.error("Could not set timezone: %s", exc)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
