#!/bin/sh
# Bring up a WiFi access point + captive-portal DHCP/DNS when the board has
# no other working network path (#131, infrastructure phase of #116). This
# is deliberately just the AP/DHCP/DNS plumbing plus the nearby-network scan
# the setup page renders as a picker (#132, see below) -- the setup page
# itself lives in setup_server.py, and wiring a submission into the
# wifi-join/rollback flow in scoreboard-provision is #133, neither done here.
#
# Trigger condition: NOT simply "no [wifi] configured" -- scoreboard-
# provision already treats that as "relying on ethernet" and does nothing
# (apply_wifi() there). This only needs to run when the board genuinely has
# no way online after boot, however it happens to be configured. A default
# route is used as the "online" signal rather than checking specific
# interface names (eth0 vs enp0s0 vs a USB dongle vary by hardware, and
# hardcoding one would be guessing) -- it is also exactly what the app
# itself needs to reach api-web.nhle.com, so "no default route" and "board
# can't do its job" are the same condition.
#
# nhl-scoreboard-setup-ap.service orders itself after
# scoreboard-provision.service, which already blocks for up to
# WIFI_CONNECT_TIMEOUT seconds resolving any configured Wi-Fi (connect, or
# roll back) before returning -- so by the time this script runs, that
# outcome is already settled and this needs no wait/retry loop of its own.
#
# iwd's own AccessPoint support (net.connman.iwd.AccessPoint, via `iwctl
# ap`) is used instead of adding hostapd as a second WiFi daemon -- this
# image already depends on iwd. iwd's AP mode only handles the 802.11 side;
# it does not assign the interface an IP or hand out leases, so this script
# still sets a static IP itself and starts dnsmasq for DHCP + wildcard DNS
# (`address=/#/<ap-addr>`, so every hostname a phone's OS probes resolves
# to the board -- that's what actually triggers the "Sign in to network"
# captive-portal prompt).
#
# `iwctl ap <dev> start-open` (an open, unencrypted network) is tried
# first, falling back to a WPA2-PSK network with a fixed passphrase if it's
# unavailable -- start-open needs a newer iwd than could be confirmed
# against the image's actual shipped Debian release without hardware.
# NOT verified against real hardware (#4); whichever mode actually started
# is logged so that can be checked on a real board.
#
# No self-monitoring teardown loop: a WiFi radio cannot be an AP and a
# station at the same time, so there is nothing meaningful to poll for on
# this interface once the AP is up. Teardown (`stop`) is meant to be driven
# by #133's submission flow once it confirms a real network joined
# successfully, not by this script guessing -- systemd's ExecStopPost
# also runs it on any `systemctl stop`, so it fires however the service
# is asked to end.
#
# Nearby-network scan (#132): this chip can't scan while its own AP is
# active (`iwctl station wlan0 get-networks` fails with "No station on
# device" once Mode is switched to ap -- confirmed live, corroborated by
# real-hardware reports on this exact brcmfmac chip family: default
# single-interface, and the documented apsta=1 concurrent-mode workaround
# is reported to crash this chip's firmware under concurrent use, so it's
# not being pursued -- see #132's issue comments). So the scan has to
# happen here, still in station mode, right before the Mode ap switch
# below, and its result cached to a file the setup page (#132) reads
# instead of scanning live. That means the list is a snapshot from just
# before the AP came up, not live -- it can miss a network that's out of
# range at that exact moment, hidden, or appears afterward, which is why
# the setup page also always offers a plain text SSID field alongside the
# picker, not just the picker alone.
set -eu

IFACE="${NHL_SCOREBOARD_AP_IFACE:-wlan0}"
SSID="${NHL_SCOREBOARD_AP_SSID:-NHL-Scoreboard-Setup}"
PASSPHRASE="${NHL_SCOREBOARD_AP_PASSPHRASE:-scoreboard}"
AP_ADDR="${NHL_SCOREBOARD_AP_ADDR:-10.42.0.1}"
AP_PREFIX="${NHL_SCOREBOARD_AP_PREFIX:-24}"
DHCP_RANGE="${NHL_SCOREBOARD_AP_DHCP_RANGE:-10.42.0.10,10.42.0.200,12h}"
DNSMASQ_CONF="${NHL_SCOREBOARD_AP_DNSMASQ_CONF:-/run/nhl-scoreboard-setup-ap-dnsmasq.conf}"
DNSMASQ_BIN="${NHL_SCOREBOARD_AP_DNSMASQ_BIN:-dnsmasq}"
# Read by the app (app.py's _ap_setup_scene) to show the SSID/password + a
# join QR code on the panel instead of the normal scoreboard while setup
# mode is active -- the only way to reach the board at all is a phone that
# can already see this, so there's no point drawing a scene nobody asked
# for and no user turned this on for. /run so it never survives a reboot
# stale, same reasoning as the dnsmasq conf above.
STATE_FILE="${NHL_SCOREBOARD_AP_STATE_FILE:-/run/nhl-scoreboard-setup-ap-state.json}"
# Read by the setup page (#132) to render the network picker. A JSON array
# of nearby SSIDs seen in the scan taken just before the AP came up -- see
# the header comment above for why this can't be a live scan instead.
SCAN_FILE="${NHL_SCOREBOARD_AP_SCAN_FILE:-/run/nhl-scoreboard-setup-ap-networks.json}"
# How long to let a scan settle before reading results back. iwctl's scan
# is asynchronous -- start it, then read get-networks after this pause.
# Not verified against real hardware timing (#4); overridable so tests
# don't have to actually wait.
SCAN_SETTLE_SECONDS="${NHL_SCOREBOARD_AP_SCAN_SETTLE_SECONDS:-2}"
# `iwctl ap ... start*` is retried once before giving up on that mode
# (#173): this chip already has documented mode-switching flakiness (see
# above), and one transient failure shouldn't leave the board with no AP
# at all. Only the pause is overridable, so tests don't have to wait.
AP_START_ATTEMPTS=2
AP_START_RETRY_SECONDS="${NHL_SCOREBOARD_AP_START_RETRY_SECONDS:-2}"

log() {
    logger -t nhl-scoreboard-setup-ap "$1"
    echo "$1"
}

is_online() {
    [ -n "$(ip route show default 2>/dev/null)" ]
}

write_dnsmasq_conf() {
    # bind-interfaces + interface=: scoped to the AP interface only, so
    # this never competes with any resolver already listening elsewhere on
    # the board. no-resolv: this instance is a captive-portal responder,
    # not a general recursive resolver -- it should never forward.
    cat > "$DNSMASQ_CONF" <<EOF
interface=$IFACE
bind-interfaces
except-interface=lo
no-resolv
dhcp-range=$DHCP_RANGE
dhcp-option=3,$AP_ADDR
dhcp-option=6,$AP_ADDR
address=/#/$AP_ADDR
EOF
}

# Minimal, dependency-free JSON string escaping (backslash and quote only --
# SSID/passphrase are shell-safe strings already, this just keeps them from
# breaking the JSON syntax around them).
json_escape() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

write_state_file() {
    # $1: "true"/"false" -- whether the AP actually came up open
    # (start-open) or WPA2-protected (the fallback). Written distinctly so
    # the app never shows/encodes a password that isn't actually required.
    if [ "$1" = "true" ]; then
        printf '{"ssid":"%s","password":null,"open":true}\n' \
            "$(json_escape "$SSID")" > "$STATE_FILE"
    else
        printf '{"ssid":"%s","password":"%s","open":false}\n' \
            "$(json_escape "$SSID")" "$(json_escape "$PASSPHRASE")" > "$STATE_FILE"
    fi
}

# Turns `iwctl station <dev> get-networks`'s table on stdin into a JSON
# array of unique SSIDs on stdout, e.g. ["Home Wifi","Guest"]. iwctl has no
# JSON output mode, so this anchors on the one thing that table format
# reliably ends each data row with -- a security token (open/psk/8021x/wep)
# followed by asterisks -- rather than fixed column positions, which shift
# with the longest SSID iwctl happens to be padding for. Best-effort and
# NOT verified against real hardware output (#4): if a real board's iwctl
# format doesn't match, this degrades to an empty list (still valid JSON),
# never a script failure -- the text-entry fallback in the setup page
# covers exactly that case.
parse_networks() {
    # $0 below is awk's own record variable, not a shell positional
    # parameter -- this whole block is a single-quoted awk program on
    # purpose, so shell must never expand anything inside it.
    # shellcheck disable=SC2016
    awk '
        /^-+$/ { next }
        /Available networks/ { next }
        /Network name/ && /Security/ { next }
        /^ *$/ { next }
        {
            line = $0
            sub(/^> */, "", line)
            sub(/^ +/, "", line)
            if (match(line, / +(open|psk|8021x|wep) +\*+ *$/)) {
                name = substr(line, 1, RSTART - 1)
                sub(/ +$/, "", name)
                if (name != "" && !(name in seen)) {
                    seen[name] = 1
                    names[n++] = name
                }
            }
        }
        END {
            printf "["
            for (i = 0; i < n; i++) {
                esc = names[i]
                gsub(/\\/, "\\\\", esc)
                gsub(/"/, "\\\"", esc)
                if (i > 0) printf ","
                printf "\"%s\"", esc
            }
            printf "]\n"
        }
    '
}

scan_networks() {
    log "Scanning for nearby networks before switching $IFACE to AP mode"
    iwctl station "$IFACE" scan >/dev/null 2>&1 || true
    sleep "$SCAN_SETTLE_SECONDS"
    if ! iwctl station "$IFACE" get-networks 2>/dev/null | parse_networks > "$SCAN_FILE"; then
        log "Could not read nearby networks; caching an empty list"
        printf '[]\n' > "$SCAN_FILE"
    fi
}

# $@: everything after `iwctl ap <dev>`, e.g. `start-open <ssid>`.
# Succeeds as soon as one attempt does; fails once all are exhausted.
ap_start_with_retry() {
    attempt=1
    while ! iwctl ap "$IFACE" "$@"; do
        if [ "$attempt" -ge "$AP_START_ATTEMPTS" ]; then
            return 1
        fi
        log "iwctl ap $IFACE $1 failed (attempt $attempt of $AP_START_ATTEMPTS); retrying in ${AP_START_RETRY_SECONDS}s"
        sleep "$AP_START_RETRY_SECONDS"
        attempt=$((attempt + 1))
    done
}

cmd_check() {
    if is_online; then
        log "Board has a default route; AP mode not needed"
        return 0
    fi
    log "No default route; AP mode needed"
    return 1
}

cmd_start() {
    if is_online; then
        log "Already online; not starting AP mode"
        return 0
    fi

    log "Bringing up $IFACE as $SSID ($AP_ADDR/$AP_PREFIX)"
    ip addr flush dev "$IFACE"
    ip addr add "$AP_ADDR/$AP_PREFIX" dev "$IFACE"
    ip link set "$IFACE" up

    # Verified live on real hardware (#131 follow-up): `iwctl ap <dev>
    # start` fails outright ("No ap on device") on this board's brcmfmac
    # driver unless the device's Mode is switched to "ap" first -- iwd does
    # NOT do this automatically as part of `ap start` here, despite "ap"
    # appearing in the wiphy's own supported iftypes. station disconnect
    # first is best-effort (harmless if already disconnected): switching
    # Mode while still attempting to autoconnect in station mode is the
    # other half of what real hardware showed was needed.
    iwctl station "$IFACE" disconnect 2>/dev/null || true
    scan_networks
    iwctl device "$IFACE" set-property Mode ap

    if ap_start_with_retry start-open "$SSID"; then
        log "AP mode: open network (no passphrase)"
        write_state_file true
    elif ap_start_with_retry start "$SSID" "$PASSPHRASE"; then
        log "AP mode: iwd start-open unavailable; fell back to WPA2-PSK"
        write_state_file false
    else
        log "Could not start AP mode on $IFACE"
        return 1
    fi

    write_dnsmasq_conf
    log "Starting dnsmasq for DHCP + captive-portal DNS on $IFACE"
    exec "$DNSMASQ_BIN" --no-daemon --conf-file="$DNSMASQ_CONF"
}

cmd_stop() {
    log "Tearing down AP mode on $IFACE"
    iwctl ap "$IFACE" stop 2>/dev/null || true
    # Verified live: the device is left in Mode=ap after `ap stop` -- it
    # does not revert on its own. #133's join flow needs the interface
    # back in station mode to have any chance of connecting to a real
    # network afterward.
    iwctl device "$IFACE" set-property Mode station 2>/dev/null || true
    ip addr flush dev "$IFACE" 2>/dev/null || true
    rm -f "$DNSMASQ_CONF" "$STATE_FILE" "$SCAN_FILE"
}

case "${1:-start}" in
    check) cmd_check ;;
    start) cmd_start ;;
    stop) cmd_stop ;;
    *)
        echo "usage: $0 {check|start|stop}" >&2
        exit 2
        ;;
esac
