<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- Lists the admin page in network browsers (#292). Port matches
     [status] port's default; a changed port isn't reflected here yet. -->
<service-group>
  <name replace-wildcards="yes">NHL Scoreboard (%h)</name>
  <service>
    <type>_http._tcp</type>
    <port>8080</port>
  </service>
</service-group>
